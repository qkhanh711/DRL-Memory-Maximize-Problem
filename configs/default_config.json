{
    "env_name": "GAIServiceEnv",
    "seed": 42,
    "device": "cuda",
    "agent_type": "gaussian_a2c",
    "total_episodes": 1000,
    "max_steps_per_episode": 10,
    "explore_episodes": 100,
    "min_buffer_size": 1000,
    "train_iterations": 10,
    "batch_size": 64,
    "buffer_size": 100000,
    "use_prioritized_replay": false,
    "log_interval": 10,
    "save_interval": 100,
    "eval_interval": 50,
    "eval_episodes": 5,
    "use_wandb": false,
    "use_tensorboard": true,
    "project_name": "drl-memory-maximize",
    "save_dir": "models",
    "log_dir": "logs",
    "gamma": 0.99,
    "lr": 0.0003,
    "tau": 0.005,
    "grad_norm": 1.0,
    "agent_specific": {
        "a2c_diffusion": {
            "beta_schedule": "linear",
            "n_timesteps": 20,
            "ema_decay": 0.995,
            "step_start_ema": 2000,
            "update_ema_every": 10,
            "entropy_coef": 0.01,
            "value_loss_coef": 0.25,
            "lr_decay": false,
            "max_grad_norm": 0.5
        },
        "bc_diffusion": {
            "beta_schedule": "linear",
            "n_timesteps": 100
        },
        "gaussian_a2c": {
            "value_coef": 0.5,
            "ent_coef": 0.01
        },
        "gaussian_dql": {
            "noise_scale": 0.3,
            "noise_type": "gaussian",
            "epsilon": 0.01,
            "policy_delay": 2
        },
        "gaussian_ppo": {
            "clip_ratio": 0.2,
            "value_clip_ratio": 0.2,
            "norm_adv": true,
            "horizon_steps": 1,
            "ent_coef": 0.01,
            "noise_scale": 0.1,
            "noise_type": "gaussian",
            "epsilon": 0.1,
            "lr_decay": false,
            "lr_maxt": 1000
        },
        "ppo_diffusion": {
            "tau": 0.95,
            "clip_param": 0.2,
            "beta_schedule": "linear",
            "n_timesteps": 10,
            "ema_decay": 0.99,
            "step_start_ema": 500,
            "update_ema_every": 3,
            "entropy_coef": 0.02,
            "value_loss_coef": 0.25,
            "warmup_steps": 200,
            "lr_decay": true,
            "lr_maxt": 10000
        },
        "ql_diffusion": {
            "max_q_backup": false,
            "eta": 1.0,
            "beta_schedule": "linear",
            "n_timesteps": 100,
            "ema_decay": 0.995,
            "step_start_ema": 1000,
            "update_ema_every": 5,
            "lr_decay": false,
            "lr_maxt": 1000
        }
    }
}